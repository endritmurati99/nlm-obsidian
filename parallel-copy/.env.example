# Optional. If left unset, this parallel copy uses its own root as the vault.
VAULT_PATH=

# Optional. Used only as a human reminder for the NotebookLM account in use.
GOOGLE_ACCOUNT=

# Search default when a skill or script does not pass --max-results explicitly.
YT_MAX_RESULTS=5

# Used by the runner scripts when --deliverable is omitted.
DEFAULT_DELIVERABLE=infographic
