# ── Obsidian ──────────────────────────────────────────────
# Absolute path to this vault (used by scripts that need to resolve file paths)
VAULT_PATH=C:/Users/yourname/Desktop/NLM+Obsidian

# ── NotebookLM ────────────────────────────────────────────
# Google account used for `notebooklm login` OAuth handshake
GOOGLE_ACCOUNT=you@gmail.com

# ── YouTube / yt-dlp ──────────────────────────────────────
# Optional: max results returned by YouTube search skill
YT_MAX_RESULTS=10

# ── Pipeline defaults ─────────────────────────────────────
# Default deliverable format: infographic | podcast | slides | mindmap | flashcards
DEFAULT_DELIVERABLE=infographic
